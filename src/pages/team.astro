---
import Layout from "../layouts/Layout.astro";

// ---------------------------------------------------------------------------
// TO ADD A TEAM MEMBER: copy one block inside the [ ] and fill in the fields.
// photo is optional — leave it out and initials will show instead.
// Save a headshot to  public/images/team/  and set photo to its path.
//
//   {
//     name: "Jane Doe",
//     role: "Postdoctoral Researcher",
//     joined: "2025",
//     bio: "Studies the nuclear androgen-receptor interactome in prostate cancer.",
//     photo: "/images/team/jane-doe.jpg",
//   },
// ---------------------------------------------------------------------------
const members = [];

// ALUMNI: { name, role, now }  ->  now is where they are today (optional)
const alumni = [];

function initials(name) {
  return name
    .split(" ")
    .filter(Boolean)
    .map((w) => w[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
}
---

<Layout title="Team — Wright Lab">
  <main class="page wide">
    <span class="section-eyebrow">Team</span>
    <h1>The people of the Wright Lab</h1>
    <p class="lead">The students, postdocs, and staff scientists who power our research.</p>

    <h2>Current Members</h2>
    {members.length === 0 ? (
      <div class="empty-state">
        <p>
          The lab is growing. Member profiles are being added. If you are interested in joining,
          see the <a href="/join/">Join Us</a> page.
        </p>
      </div>
    ) : (
      <div class="card-grid" style="margin-top: 1.5rem;">
        {members.map((m) => (
          <div class="card">
            {m.photo ? (
              <img src={m.photo} alt={m.name} class="member-photo" />
            ) : (
              <div class="member-initials">{initials(m.name)}</div>
            )}
            <h3>{m.name}</h3>
            <p class="muted">{m.role}{m.joined ? ` · Joined ${m.joined}` : ""}</p>
            {m.bio && <p>{m.bio}</p>}
          </div>
        ))}
      </div>
    )}

    <h2 style="margin-top: 4rem;">Alumni</h2>
    {alumni.length === 0 ? (
      <p class="muted"><em>Alumni profiles coming soon.</em></p>
    ) : (
      <ul class="alumni-list">
        {alumni.map((a) => (
          <li>
            <strong>{a.name}</strong> · {a.role}{a.now ? ` · ${a.now}` : ""}
          </li>
        ))}
      </ul>
    )}
  </main>

  <style>
    .member-photo {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: var(--radius);
      margin-bottom: 1rem;
    }
    .member-initials {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--color-accent);
      background: var(--color-accent-light);
    }
    .empty-state {
      margin-top: 1.5rem;
      padding: 2rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      color: var(--color-text-muted);
    }
    .empty-state p { margin: 0; }
    .alumni-list {
      list-style: none;
      padding: 0;
      margin-top: 1.5rem;
    }
    .alumni-list li {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
    }
    .alumni-list li:last-child { border-bottom: none; }
  </style>
</Layout>
